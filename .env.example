# SKYGUARD Root Environment Configuration Template
# Copy this file or configure backend/.env and frontend/.env.local respectively

# --- Backend Configuration ---
# Get free NASA FIRMS key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_firms_map_key_here
DEFAULT_SENSOR=VIIRS_NOAA20_NRT
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIRMS_CACHE_TTL=600
WEATHER_CACHE_TTL=1800
DEMO_MODE=false

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
