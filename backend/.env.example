# NASA FIRMS API Map Key
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=your_firms_map_key_here

# Default Satellite Sensor: VIIRS_NOAA20_NRT, VIIRS_SNPP_NRT, VIIRS_NOAA21_NRT, MODIS_NRT
DEFAULT_SENSOR=VIIRS_NOAA20_NRT

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache TTL in seconds (NASA data: 600s = 10 mins, Weather: 1800s = 30 mins)
FIRMS_CACHE_TTL=600
WEATHER_CACHE_TTL=1800

# Demo Mode toggle (true forces demo mode, false uses live API if key is present)
DEMO_MODE=false
